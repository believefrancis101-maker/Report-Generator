# Copy to `.env` and adjust. `.env` is git-ignored - never commit real secrets.

# --- Required ---------------------------------------------------------------
# PostgreSQL connection string. Matches the docker-compose dev database.
# The host port must match POSTGRES_PORT below.
DATABASE_URL=postgresql://report:report_local_dev@localhost:55432/report_generator?schema=public
# Host port the PostgreSQL container is published on (docker-compose default).
POSTGRES_PORT=55432

# --- Server -----------------------------------------------------------------
# TCP port for the API server (1-65535).
PORT=3000

# --- Queue behaviour --------------------------------------------------------
# Maximum delivery attempts per job (positive integer).
MAX_ATTEMPTS=5
# Jobs processed concurrently by a single worker (positive integer).
CONCURRENCY=3
# Base delay in ms for exponential backoff between retries (positive integer).
BACKOFF_BASE_MS=2000
# Upper bound in ms for the backoff delay; must be >= BACKOFF_BASE_MS.
BACKOFF_MAX_MS=300000
# A job running longer than this (ms) is considered stuck (positive integer).
STUCK_TIMEOUT_MS=60000
# Interval in ms between stuck-job sweeps (positive integer).
SWEEP_INTERVAL_MS=15000
# Interval in ms between job polls by the worker (positive integer).
POLL_INTERVAL_MS=1000
# Identity of the worker process; defaults to `<hostname>-<pid>`.
WORKER_ID=

# --- TEST-ONLY (local development / automated tests) ------------------------
# The settings below exist to exercise failure paths in tests. They are NOT
# production controls and must never be enabled in a deployed environment.
#
# Probability (0..1) that a unit of work fails on purpose.
FAIL_RATE=0
# Crash the worker right after the first unit of work.
CRASH_AFTER_WORK=false
# Artificial delay (ms) injected into every unit of work.
WORK_DELAY_MS=0
