{
  "name": "report-generator",
  "version": "0.1.0",
  "private": true,
  "description": "Report generator with a durable background job queue on PostgreSQL - no external broker required",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev:api": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start:api": "node dist/src/server.js",
    "start:worker": "node dist/src/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:setup": "tsx scripts/test-db.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "evidence:concurrency": "tsx scripts/evidence-concurrency.ts",
    "evidence:backoff": "tsx scripts/evidence-backoff.ts",
    "evidence:kill-recovery": "tsx scripts/evidence-kill-recovery.ts",
    "evidence:idempotency-key": "tsx scripts/evidence-idempotency-key.ts",
    "evidence:two-workers": "tsx scripts/evidence-two-workers.ts",
    "evidence:crash-after-work": "tsx scripts/evidence-crash-after-work.ts",
    "evidence:all-statuses": "tsx scripts/evidence-all-statuses.ts",
    "evidence:screenshots": "tsx scripts/evidence-screenshots.ts"
  },
  "dependencies": {
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.5",
    "playwright": "^1.64.1",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
